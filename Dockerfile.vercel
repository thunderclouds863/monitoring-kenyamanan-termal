# Vercel container: Apache + PHP 8.2. Database = MySQL eksternal (TiDB Cloud) via env DB_HOST dkk.
# Seed sekali ke DB eksternal (deploy/seed.php), session disimpan di DB (deploy/db_compat.php).
FROM php:8.2-apache
RUN apt-get update \
 && apt-get install -y --no-install-recommends libzip-dev libpng-dev unzip \
 && docker-php-ext-install mysqli pdo_mysql zip gd \
 && rm -rf /var/lib/apt/lists/*
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY deploy/php-demo.ini /usr/local/etc/php/conf.d/zz-demo.ini
COPY deploy/legacy.php /usr/local/etc/php/legacy.php
WORKDIR /var/www/html
COPY . .
RUN if [ -f composer.json ] && [ ! -f vendor/composer/autoload_real.php ]; then composer install --no-dev --no-interaction --no-progress; fi \
 && mkdir -p vendor/PHPMailer-master \
 && ln -sfn ../phpmailer/phpmailer/src vendor/PHPMailer-master/src \
 && chown -R www-data:www-data /var/www/html
CMD ["bash", "deploy/start-vercel.sh"]
